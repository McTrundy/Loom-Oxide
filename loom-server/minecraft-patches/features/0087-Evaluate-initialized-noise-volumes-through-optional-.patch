diff --git a/net/minecraft/world/level/levelgen/synth/OxideNoise.java b/net/minecraft/world/level/levelgen/synth/OxideNoise.java
new file mode 100644
index 0000000000000000000000000000000000000000..1a1beff9f8db34cd30aff51dde080cbb7de38215
--- /dev/null
+++ b/net/minecraft/world/level/levelgen/synth/OxideNoise.java
@@ -0,0 +1,202 @@
+package net.minecraft.world.level.levelgen.synth;
+
+import com.mojang.logging.LogUtils;
+import java.lang.foreign.Arena;
+import java.lang.foreign.FunctionDescriptor;
+import java.lang.foreign.Linker;
+import java.lang.foreign.MemorySegment;
+import java.lang.foreign.SymbolLookup;
+import java.lang.foreign.ValueLayout;
+import java.lang.invoke.MethodHandle;
+import java.lang.ref.Reference;
+import java.nio.file.Path;
+import net.minecraft.SharedConstants;
+import net.minecraft.world.level.levelgen.densityfunction.DensityBuffer;
+import net.minecraft.world.level.levelgen.densityfunction.DensityVolume;
+import org.jspecify.annotations.Nullable;
+
+/** Opt-in synchronous evaluation of initialized, immutable noise layers. */
+public final class OxideNoise {
+    private static final long LAYER_BYTES = 304;
+    private static final long VOLUME_BYTES = 64;
+    private static final String MODE = System.getProperty("loom.oxide.noiseBackend", "java");
+    private static final @Nullable NativeCall CALL = load();
+    private final MemorySegment layers;
+    private final int layerCount;
+
+    private OxideNoise(MemorySegment layers, int layerCount) {
+        this.layers = layers;
+        this.layerCount = layerCount;
+    }
+
+    /** Called before server owners start, so library loading never blocks a tick. */
+    public static void initialize() {
+        // Class initialization validates the selected library before world setup.
+    }
+
+    public static String backendName() {
+        return MODE;
+    }
+
+    private static @Nullable NativeCall load() {
+        if (MODE.equals("java")) return null;
+        if (!MODE.equals("ffm") && !MODE.equals("jffi")) throw new IllegalArgumentException("Unknown loom.oxide.noiseBackend: " + MODE);
+        String filename = System.getProperty("loom.oxide.nativeLibrary");
+        if (filename == null || filename.isBlank()) {
+            throw new IllegalStateException("Native noise requires -Dloom.oxide.nativeLibrary=<library path>");
+        }
+        Path path = Path.of(filename).toAbsolutePath().normalize();
+        try {
+            NativeCall call = switch (MODE) {
+                case "ffm" -> new FfmCall(path);
+                case "jffi" -> new JffiCall(path);
+                default -> throw new IllegalArgumentException("Unknown loom.oxide.noiseBackend: " + MODE);
+            };
+            if (ValueLayout.ADDRESS.byteSize() != 8 || call.version() != 1
+                || call.layout() != (LAYER_BYTES << 32 | VOLUME_BYTES)) {
+                throw new IllegalStateException("Native noise ABI/layout does not match this runtime");
+            }
+            LogUtils.getLogger().info("Loom Oxide noise backend: {}", MODE);
+            return call;
+        } catch (Throwable failure) {
+            throw propagate(failure);
+        }
+    }
+
+    static @Nullable OxideNoise create(NoiseStack.Layer[] source) {
+        if (CALL == null || source.length == 0) return null;
+        for (NoiseStack.Layer layer : source) {
+            Class<?> type = layer.noise().getClass();
+            if (type != PerlinNoise.class && type != SmearedPerlinNoise.class) return null;
+            if (!Double.isFinite(layer.frequency()) || !Float.isFinite(layer.amplitude())) return null;
+            if (layer.noise() instanceof SmearedPerlinNoise smeared && !Double.isFinite(smeared.fudgeYScale())) return null;
+        }
+        Arena arena = Arena.ofAuto();
+        MemorySegment state = arena.allocate(Math.multiplyExact(LAYER_BYTES, source.length), 8);
+        for (int index = 0; index < source.length; index++) {
+            NoiseStack.Layer layer = source[index];
+            PerlinNoise noise = (PerlinNoise) layer.noise();
+            long base = index * LAYER_BYTES;
+            state.set(ValueLayout.JAVA_DOUBLE, base, noise.offsetX);
+            state.set(ValueLayout.JAVA_DOUBLE, base + 8, noise.offsetY);
+            state.set(ValueLayout.JAVA_DOUBLE, base + 16, noise.offsetZ);
+            state.set(ValueLayout.JAVA_DOUBLE, base + 24, layer.frequency());
+            state.set(ValueLayout.JAVA_DOUBLE, base + 32, noise instanceof SmearedPerlinNoise smeared ? smeared.fudgeYScale() : 0.0);
+            state.set(ValueLayout.JAVA_FLOAT, base + 40, layer.amplitude());
+            state.set(ValueLayout.JAVA_INT, base + 44, noise instanceof SmearedPerlinNoise ? 1 : 0);
+            MemorySegment.copy(MemorySegment.ofArray(noise.perms), 0, state, base + 48, 256);
+        }
+        return new OxideNoise(state, source.length);
+    }
+
+    boolean addToVolume(DensityBuffer buffer, DensityVolume volume, double xzScale, double yScale, float amplitude) {
+        NativeCall call = CALL;
+        if (call == null) return false;
+        if (!Double.isFinite(xzScale) || !Double.isFinite(yScale) || !Float.isFinite(amplitude)) return false;
+        long columns = (long) volume.sizeX() * volume.sizeZ();
+        if (columns > Integer.MAX_VALUE / volume.sizeY()) return false;
+        long count = columns * volume.sizeY();
+        if (count > buffer.size()) return false;
+        long bytes = count * Float.BYTES;
+        try (Arena scratch = Arena.ofConfined()) {
+            MemorySegment output = scratch.allocate(bytes, Float.BYTES);
+            MemorySegment original = buffer.asMemorySegment().asSlice(0, bytes);
+            output.copyFrom(original);
+            MemorySegment spec = scratch.allocate(VOLUME_BYTES, 8);
+            spec.set(ValueLayout.JAVA_INT, 0, volume.sizeX());
+            spec.set(ValueLayout.JAVA_INT, 4, volume.sizeY());
+            spec.set(ValueLayout.JAVA_INT, 8, volume.sizeZ());
+            spec.set(ValueLayout.JAVA_INT, 12, volume.minBlockX());
+            spec.set(ValueLayout.JAVA_INT, 16, volume.minBlockY());
+            spec.set(ValueLayout.JAVA_INT, 20, volume.minBlockZ());
+            spec.set(ValueLayout.JAVA_INT, 24, volume.stepBlockX());
+            spec.set(ValueLayout.JAVA_INT, 28, volume.stepBlockY());
+            spec.set(ValueLayout.JAVA_INT, 32, volume.stepBlockZ());
+            spec.set(ValueLayout.JAVA_INT, 36, SharedConstants.DEBUG_ENABLE_FARLANDS ? 0 : 1);
+            spec.set(ValueLayout.JAVA_DOUBLE, 40, xzScale);
+            spec.set(ValueLayout.JAVA_DOUBLE, 48, yScale);
+            spec.set(ValueLayout.JAVA_FLOAT, 56, amplitude);
+            spec.set(ValueLayout.JAVA_INT, 60, 0);
+            int status;
+            try {
+                status = call.volume(this.layers, this.layerCount, spec, output, count);
+            } catch (Throwable failure) {
+                throw propagate(failure);
+            } finally {
+                // JFFI receives raw addresses; keep their automatic arena alive.
+                Reference.reachabilityFence(this.layers);
+            }
+            if (status != 0) throw new IllegalStateException("Native noise evaluation failed: status " + status);
+            // Never expose a partially computed native result to the Java caller.
+            original.copyFrom(output);
+        }
+        return true;
+    }
+
+    private static RuntimeException propagate(Throwable failure) {
+        if (failure instanceof Error error) throw error;
+        if (failure instanceof RuntimeException error) return error;
+        return new IllegalStateException("Native noise call failed", failure);
+    }
+
+    private interface NativeCall {
+        int version() throws Throwable;
+        long layout() throws Throwable;
+        int volume(MemorySegment layers, long layerCount, MemorySegment volume, MemorySegment output, long outputCount) throws Throwable;
+    }
+
+    private static final class FfmCall implements NativeCall {
+        private final Arena libraryArena = Arena.ofAuto();
+        private final MethodHandle version, layout, volume;
+
+        FfmCall(Path path) {
+            SymbolLookup library = SymbolLookup.libraryLookup(path, this.libraryArena);
+            Linker linker = Linker.nativeLinker();
+            this.version = linker.downcallHandle(library.find("oxide_noise_abi_version").orElseThrow(), FunctionDescriptor.of(ValueLayout.JAVA_INT));
+            this.layout = linker.downcallHandle(library.find("oxide_noise_layout").orElseThrow(), FunctionDescriptor.of(ValueLayout.JAVA_LONG));
+            this.volume = linker.downcallHandle(library.find("oxide_noise_volume_v1").orElseThrow(), FunctionDescriptor.of(ValueLayout.JAVA_INT,
+                ValueLayout.ADDRESS, ValueLayout.JAVA_LONG, ValueLayout.ADDRESS, ValueLayout.ADDRESS, ValueLayout.JAVA_LONG));
+        }
+
+        @Override public int version() throws Throwable { return (int) this.version.invokeExact(); }
+        @Override public long layout() throws Throwable { return (long) this.layout.invokeExact(); }
+        @Override public int volume(MemorySegment layers, long layerCount, MemorySegment spec, MemorySegment output, long outputCount) throws Throwable {
+            return (int) this.volume.invokeExact(layers, layerCount, spec, output, outputCount);
+        }
+    }
+
+    private static final class JffiCall implements NativeCall {
+        private final com.kenai.jffi.Library library;
+        private final com.kenai.jffi.Invoker invoker = com.kenai.jffi.Invoker.getInstance();
+        private final com.kenai.jffi.CallContext versionContext, layoutContext, volumeContext;
+        private final long version, layout, volume;
+
+        JffiCall(Path path) {
+            this.library = com.kenai.jffi.Library.getCachedInstance(path.toString(), com.kenai.jffi.Library.NOW | com.kenai.jffi.Library.LOCAL);
+            if (this.library == null) throw new IllegalStateException("Cannot load native noise: " + com.kenai.jffi.Library.getLastError());
+            this.version = symbol("oxide_noise_abi_version");
+            this.layout = symbol("oxide_noise_layout");
+            this.volume = symbol("oxide_noise_volume_v1");
+            this.versionContext = context(com.kenai.jffi.Type.UINT32);
+            this.layoutContext = context(com.kenai.jffi.Type.UINT64);
+            this.volumeContext = context(com.kenai.jffi.Type.SINT32, com.kenai.jffi.Type.POINTER, com.kenai.jffi.Type.UINT64,
+                com.kenai.jffi.Type.POINTER, com.kenai.jffi.Type.POINTER, com.kenai.jffi.Type.UINT64);
+        }
+
+        private long symbol(String name) {
+            long address = this.library.getSymbolAddress(name);
+            if (address == 0) throw new IllegalStateException("Missing native noise symbol: " + name);
+            return address;
+        }
+
+        private static com.kenai.jffi.CallContext context(com.kenai.jffi.Type result, com.kenai.jffi.Type... arguments) {
+            return com.kenai.jffi.CallContext.getCallContext(result, arguments, com.kenai.jffi.CallingConvention.DEFAULT, false);
+        }
+
+        @Override public int version() { return (int) this.invoker.invokeN0(this.versionContext, this.version); }
+        @Override public long layout() { return this.invoker.invokeN0(this.layoutContext, this.layout); }
+        @Override public int volume(MemorySegment layers, long layerCount, MemorySegment spec, MemorySegment output, long outputCount) {
+            return (int) this.invoker.invokeN5(this.volumeContext, this.volume, layers.address(), layerCount, spec.address(), output.address(), outputCount);
+        }
+    }
+}
